@if (!isInHome)
{
    <nav class="flex-column">
    <div class="nav-item px-3">
        <NavLink onclick="@(() => GoHome())" class="nav-link" href="" Match="NavLinkMatch.All"> 
                    <MudIcon Icon="@Icons.Material.Filled.Home" Title="Favorite" />
        </NavLink>
        </div>
        </nav>
}
else
{
    <nav class="flex-column">
    <div class="nav-item px-3">
        <NavLink onclick="@(() => GoSettings())" class="nav-link" href="settings">
            <MudIcon Icon="@Icons.Material.Filled.Settings" Title="Favorite" />
        </NavLink>
    </div>
        </nav>
}

@code
{
    private bool isInHome = true;

    private void GoSettings()
    {
        isInHome = false;
        StateHasChanged();
    }

    private void GoHome()
    {
        isInHome = true;
        StateHasChanged();
    }
}