@using PizzaTime.Models
@using PizzaTime.Enums
@using System.Collections.ObjectModel

@inject PizzaTimer timer
@inject PizzaMediaPlayer player
@inject PizzaMediaManager mediaManager
@inject IDialogService DialogService

@page "/settings"

<h1>Settings</h1>
<br />

<h4>Alarmmusik wählen</h4>

<MudStack Row="true" Spacing="1" AlignItems="AlignItems.Start" Justify="Justify.FlexStart">
	<MudSelect @bind-Value="_selectedTrackName"
			   MultiSelection="false"
			   T="string"
			   Variant="Variant.Outlined"
			   SelectedValuesChanged="((IEnumerable<string> value) => OnSelectedTrackChanged(value))">
		@foreach (var track in mediaManager.MediaFiles)
		{
			<MudSelectItem Value="@track.Key">@track.Key</MudSelectItem>
		}
	</MudSelect>
</MudStack>

<br />

@if (!_isDownloading)
{
<MudStack Row="true" Spacing="1" AlignItems="AlignItems.Start" Justify="Justify.FlexStart">
			<MudButton Variant="Variant.Filled"
					   Color="Color.Primary"
						   StartIcon="@Icons.Material.Filled.CloudUpload"
						   OnClick="UploadFiles">
				Upload Music
			</MudButton>
	<MudButton Variant="Variant.Filled" Disabled="@mediaManager.IsUsingStandardTrack" OnClick="DeleteFile" StartIcon="@Icons.Material.Filled.Delete" Color="Color.Error">Delete</MudButton>
</MudStack>
}
else
{
	<MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}

<br />

<MudSlider Value="@player.Volume" T="double" Min="0.0" Max="100.0" ValueChanged="@((double value) => OnVolumeChange(value))" Size="Size.Large">Lautstärke</MudSlider>

<br />
<br />

<MudStack Row="true" Spacing="1" AlignItems="AlignItems.Start" Justify="Justify.FlexStart">
	<MudPaper Width="150px" Elevation=0>
		<MudTextField T="string" Text="@("Pizzas gesamt")" ReadOnly="true" Variant="Variant.Text" Underline="false" />
	</MudPaper>
	<MudPaper Width="60px" Elevation=0>
		<MudNumericField T="int" @bind-Value="PizzaSettings.AllTimeNumberOffPizzas" Underline="false" Disabled="isTotalPizzasDisabled" Variant="Variant.Text" Min="0" Max="999" />
	</MudPaper>
	<MudPaper Width="80px" Elevation=0 />
	<MudIconButton Variant="Variant.Filled" Icon="@lockIcon" OnClick="OnLock"></MudIconButton>
</MudStack>

<br />


<h4>Anzahl Phasen</h4>
<MudStack Row="true" Spacing="2" AlignItems="AlignItems.Start" Justify="Justify.FlexStart">
	<MudPaper Width="100px" Elevation=0 >
		<MudTextField T="string" Text="@("Phasen")" ReadOnly="true" Variant="Variant.Text" Underline="false" />
	</MudPaper>
	<MudPaper Width="60px" Elevation=0>
		<MudNumericField T="int" @bind-Value="numberOfPhases" Underline="false" Variant="Variant.Text" Min="1" Max="4" />
	</MudPaper>
</MudStack>


<h4>Alle Werte in Sekunden</h4>
<MudStack Row="true" Spacing="2" AlignItems="AlignItems.Start" Justify="Justify.FlexStart">
	<MudPaper Width="100px" Elevation=0>
		<MudTextField T="string" Text="@("Erster Timer")" ReadOnly="true" Variant="Variant.Text" Underline="false" />
	</MudPaper>
	<MudPaper Width="60px" Elevation=0>
		<MudNumericField T="int" @bind-Value="PizzaSettings.FirstTimer" Underline="false" Variant="Variant.Text" Min="0" Max="999" />
	</MudPaper>
</MudStack>
<MudStack Row="true" Spacing="2" AlignItems="AlignItems.Start" Justify="Justify.FlexStart">
	<MudPaper Width="100px" Elevation=0>
		<MudTextField T="string" Text="@("Zweiter Timer")" Disabled="isSecondPhaseDisabled" ReadOnly="true" Variant="Variant.Text" Underline="false" />
	</MudPaper>
	<MudPaper Width="60px" Elevation=0>
		<MudNumericField T="int" @bind-Value="PizzaSettings.SecondTimer" Disabled="isSecondPhaseDisabled" Underline="false" Variant="Variant.Text" Min="0" Max="999" />
	</MudPaper>
</MudStack>
<MudStack Row="true" Spacing="2" AlignItems="AlignItems.Start" Justify="Justify.FlexStart">
	<MudPaper Width="100px" Elevation=0>
		<MudTextField T="string" Text="@("Dritter Timer")" Disabled="isThirdPhaseDisabled" ReadOnly="true" Variant="Variant.Text" Underline="false" />
	</MudPaper>
	<MudPaper Width="60px" Elevation=0>
		<MudNumericField T="int" @bind-Value="PizzaSettings.ThirdTimer" Disabled="isThirdPhaseDisabled" Underline="false" Variant="Variant.Text" Min="0" Max="999" />
	</MudPaper>
</MudStack>
<MudStack Row="true" Spacing="2" AlignItems="AlignItems.Start" Justify="Justify.FlexStart">
	<MudPaper Width="100px" Elevation=0>
		<MudTextField T="string" Text="@("Vierter Timer")" Disabled="isFourthPhaseDisabled" ReadOnly="true" Variant="Variant.Text" Underline="false" />
	</MudPaper>
	<MudPaper Width="60px" Elevation=0>
		<MudNumericField T="int" @bind-Value="PizzaSettings.FourthTimer" Disabled="isFourthPhaseDisabled" Underline="false" Variant="Variant.Text" Min="0" Max="999" />
	</MudPaper>
</MudStack>

@code
{
	private string _selectedTrackName;

	private bool isTotalPizzasDisabled = true;

	private int numberOfPhases
	{
		get
		{
			return PizzaSettings.NumberOfPhases;
		}
		set 
		{ 
			PizzaSettings.NumberOfPhases = value;
			OnPhaseChange();
		}
	}

	private bool isSecondPhaseDisabled = PizzaSettings.NumberOfPhases < 2;
	private bool isThirdPhaseDisabled = PizzaSettings.NumberOfPhases < 3;
	private bool isFourthPhaseDisabled = PizzaSettings.NumberOfPhases < 4;


	private bool _isDownloading = false;

	private string lockIcon
	{
		get
		{
			if (isTotalPizzasDisabled)
			{
				return Icons.Material.Filled.Lock;
			}
			else
			{
				return Icons.Material.Filled.LockOpen;
			}
		}
	}

	void OnPhaseChange()
	{
		
		isSecondPhaseDisabled = PizzaSettings.NumberOfPhases < 2;
		isThirdPhaseDisabled = PizzaSettings.NumberOfPhases < 3;
		isFourthPhaseDisabled = PizzaSettings.NumberOfPhases < 4;
		StateHasChanged();
	}
	
	void OnLock()
	{
		isTotalPizzasDisabled = !isTotalPizzasDisabled;
		StateHasChanged();
	}

	private async Task DeleteFile(MouseEventArgs e)
	{
		string songToDelete = _selectedTrackName;
		mediaManager.SetSelectedTrackToStandard();
		_selectedTrackName = mediaManager.GetSelectedTrackName();
		OnSelectedTrackChanged(new List<string>() { _selectedTrackName });
		mediaManager.RemoveMedia(songToDelete);
		StateHasChanged();
	}

	private async Task UploadFiles()
	{
		var options = new PickOptions
		{
			PickerTitle = "MP3 auswählen",
			FileTypes = new FilePickerFileType(new Dictionary<DevicePlatform, IEnumerable<string>>
		{
			{ DevicePlatform.WinUI, new[] { ".mp3" } },
			{ DevicePlatform.Android, new[] { "audio/mpeg" } },
			{ DevicePlatform.iOS, new[] { "public.mp3" } },
			{ DevicePlatform.MacCatalyst, new[] { "public.mp3" } },
		})
		};

		var pickedFile = await FilePicker.Default.PickAsync(options);
		if (pickedFile == null)
			return;

		_isDownloading = true;
		StateHasChanged();

		// FileHandelingResult result = mediaManager.AddMedia(file).Result;

		var result = mediaManager.AddMedia(pickedFile.FullPath);

		_isDownloading = false;
		StateHasChanged();

		if (result == FileHandelingResult.Success)
		{
			string name = Path.GetFileNameWithoutExtension(pickedFile.FullPath);
			_selectedTrackName = name;
			OnSelectedTrackChanged(new List<string>() { name });
			DialogService.ShowMessageBox(
			"Erfolg",
			"Neues Lied erfolgreich hochgeladen",
			yesText: "Cool!");

			StateHasChanged();
		}
		else
		{
			string message = null;

			switch (result)
			{
				case FileHandelingResult.InvalidFileFormat:
					message = "Ungültiger Dateityp. Bitte laden Sie eine gültige mp3-Audiodatei hoch.";
					break;
				case FileHandelingResult.FileAlreadyExists:
					message = "Die Datei existiert bereits. Bitte löschen sie die Datei bevor sie es erneut versuchen.";
					break;
				case FileHandelingResult.UnknownError:
					message = "Ein unbekannter Fehler ist aufgetreten. Bitte kontaktieren sie ihren Entwickler.";
					break;
				case FileHandelingResult.FileSizeExceedsLimit:
					message = "Die Datei ist zu groß um sie zu speichern. Bitte wählen sie etwas Kleineres.";
					break;
				case FileHandelingResult.TooManyTracks:
					message = "Zu viele Tracks bereits gespeichert. Bitte löschen sie ein paar und versuchens sie es erneut.";
					break;
				default:
					message = "Ich habe keine Ahnung, was passiert ist. Am besten dem Entwickler Bescheid geben.";
					break;
			}


			DialogService.ShowMessageBox(
			"Misserfolg",
			message,
			yesText: "Nicht Cool!");
		}
	}

	private void OnSelectedTrackChanged(IEnumerable<string> value)
	{
		if (value == null || !value.Any())
		{
			return;
		}

		mediaManager.SetSelectedTrack(value.FirstOrDefault());
		player.UpdateTrack();
	}

	private void OnVolumeChange(double value)
	{
		player.Volume = value;

		if (!player.IsPlaying)
		{
			player.Play();
		}
	}

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();
		_selectedTrackName = mediaManager.GetSelectedTrackName();
		timer.StopCommand.Execute(null);
		player.Stop();
	}
}
