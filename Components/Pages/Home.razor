@using PizzaTime.Models
@using Plugin.Maui.Audio

@inject PizzaTimer timer
@inject PizzaMediaPlayer player

@page "/"


<MudStack Spacing="5" AlignItems="AlignItems.Center">
<h1> Pizza Time!</h1>
<h3> Pizzas gemacht: @TimerSettings.NumberOfPizzas</h3>
<h3> Aktuelle Phase: @TimerSettings.CurrentPhase</h3>
</MudStack>

@if (isPhaseCurrentlyDone)
{
	<MudImage Src="fire.gif" Width="150" Height="150" Alt="Pizza" Elevation="25" Class="rounded-lg" />
	<br />
	<MudStack AlignItems="AlignItems.Center">
		<MudIconButton Variant="Variant.Filled" Icon="@Icons.Material.Filled.NotStarted" OnClick="NextPhase" Color="Color.Primary" Style="width: 150px; height: 60px;"></MudIconButton>
	</MudStack>
}
else
{
	<MudStack AlignItems="AlignItems.Center">
		<MudImage Src="pizza_432339.png" Width="300" Height="300" Alt="Pizza" Elevation="25" Class="rounded-lg" />
		
		<MudTextField T="string" @bind-Text="timer.ElapsedTime" ReadOnly="true" Variant="Variant.Text" Underline="false" />
			</MudStack>
	<MudStack Row="true" Spacing="5" AlignItems="AlignItems.Center">
		<MudIconButton Variant="Variant.Filled" Icon="@playIcon" OnClick="StartPause" Color="Color.Primary" Style="width: 150px; height: 60px;"></MudIconButton>
		<MudIconButton Variant="Variant.Filled" Icon="@Icons.Material.Filled.Stop" OnClick="Stop" Disabled="isNotRunning" Color="Color.Error" Style="width: 150px; height: 60px;"></MudIconButton>
	</MudStack>
}

@code
{
	private bool isPhaseCurrentlyDone = false;

	private string playIcon
	{
		get
		{
			if (timer.IsRunning)
			{
				return Icons.Material.Filled.Pause;
			}
			else
			{
				return Icons.Material.Filled.PlayArrow;
			}
		}
	}

	private bool isNotRunning = true;

	void NextPhase()
	{
		player.Stop();
		isPhaseCurrentlyDone = false;

		if (TimerSettings.CurrentPhase <= 3)
		{
			TimerSettings.CurrentPhase++;
			timer.StartCommand.Execute(null);
			isNotRunning = false;
		}
		else
		{
			TimerSettings.CurrentPhase = 1;
			TimerSettings.NumberOfPizzas++;
		}

		timer.PhaseTime = TimerSettings.GetCurrentPhaseTime();

		StateHasChanged();
	}

	void StartPause()
	{
		if (timer.IsRunning)
		{
			timer.PauseCommand.Execute(null);
		}
		else
		{
			timer.StartCommand.Execute(null);
			isNotRunning = false;
		}

		StateHasChanged();
	}

	void Stop()
	{
		timer.StopCommand.Execute(null);
		isNotRunning = true;
		StateHasChanged();
	}

	private void OnNewTimestamp()
	{
		StateHasChanged();
	}

	private void OnPhaseDone()
	{
		player.Play();
		isPhaseCurrentlyDone = true;

		StateHasChanged();
	}

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();
		timer.PhaseTime = TimerSettings.GetCurrentPhaseTime();
		timer.newTimeStamp += OnNewTimestamp;
		timer.phaseDone += OnPhaseDone;

		StateHasChanged();
	}
}